# Names only. Never commit values. Set them in Cloudflare Pages (Settings → Environment variables).

# Public site URL (production domain). Previews set SITE_URL and SITE_BASE in the workflow.
SITE_URL=
SITE_BASE=

# Stripe Checkout – TEST MODE keys (sk_test_...) until the owner goes live.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Unlock token signing (Ed25519). Private key used only by functions/api/verify.ts;
# the public key is embedded in the static build to verify tokens in the browser.
UNLOCK_SIGNING_KEY=
PUBLIC_UNLOCK_VERIFY_KEY=

# Optional Zotero library linking. Keep unset/false until a human confirms api.zotero.org allows CORS from the site.
PUBLIC_ENABLE_LINKING=

# Cloudflare Web Analytics (cookie-free). Leave empty to load no analytics at all.
PUBLIC_CF_BEACON_TOKEN=

# Anonymous event counter (functions/api/event.ts) – binding name of a Workers Analytics Engine dataset or KV namespace, set in Cloudflare.
EVENTS_BINDING=
