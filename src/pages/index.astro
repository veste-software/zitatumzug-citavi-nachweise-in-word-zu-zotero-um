---
import Base from '../layouts/Base.astro';
import Tag from '../components/Tag.astro';
import Converter from '../components/Converter';
---
<Base
  title="Citavi-Nachweise in Word zu Zotero umwandeln – Zitatumzug"
  description="Wandelt die Citavi-Nachweise in Ihrem Word-Dokument in Zotero-Felder um – im Browser, ohne Upload und ohne Citavi-Lizenz."
>
  <div class="main-col">
    <h1>Citavi-Nachweise in Word zu Zotero umwandeln</h1>
    <p>
      Ihre Word-Datei enthält zu jedem Citavi-Nachweis die vollständigen Literaturangaben. Zitatumzug
      liest sie aus und schreibt Zotero-Felder – mit Seitenzahlen, Präfixen und Fußnoten.
    </p>
    <p><strong>Ihre Datei wird nur in Ihrem Browser verarbeitet und nirgendwohin hochgeladen.</strong></p>
    <Converter client:load />
  </div>
  <aside class="margin-col" aria-label="Preis">
    <Tag label="Umzugspass" big="9 €" detail="einmalig, 30 Tage, inkl. MwSt." variant="manila">
      <p class="stamp" style="margin-top: 1rem">Scan gratis</p>
    </Tag>
  </aside>
</Base>
