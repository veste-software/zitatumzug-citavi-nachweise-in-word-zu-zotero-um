---
import '../styles/global.css';
import { href } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** set false for pages that must not be indexed (404) */
  index?: boolean;
  /** schema.org objects that are true for this page (rendered as JSON-LD) */
  jsonLd?: Record<string, unknown>[];
}
const { title, description, index = true, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!index && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Zitatumzug" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {jsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...obj })} />
    ))}
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <meta name="theme-color" content="#c8a97e" />
    {beaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: beaconToken })}
      ></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <header class="site-header">
      <a class="wordmark" href={href('/')}>Zitatumzug</a>
      <nav class="site-nav" aria-label="Hauptnavigation">
        <a href={href('/')}>Umwandeln</a>
        <a href={href('/citavi-lizenz-abgelaufen/')}>Lizenz abgelaufen?</a>
        <a href={href('/citavi-felder-zotero/')}>Citavi-Felder erklärt</a>
        <a href={href('/literaturliste-aus-word-retten/')}>Literaturliste retten</a>
      </nav>
    </header>
    <main id="inhalt" class="sheet">
      <slot />
    </main>
    <footer class="site-footer">
      <nav aria-label="Rechtliches">
        <a href={href('/impressum/')}>Impressum</a>
        <a href={href('/datenschutz/')}>Datenschutz</a>
        <a href={href('/kaufbedingungen/')}>Kaufbedingungen &amp; Widerruf</a>
      </nav>
      <p>
        Zitatumzug ist ein unabhängiges Werkzeug. Es steht in keiner Verbindung zu Lumivero/Citavi
        oder zu Zotero bzw. der Corporation for Digital Scholarship. Die Namen werden nur
        beschreibend verwendet.
      </p>
    </footer>
  </body>
</html>
